# RAUC Web UI Configuration
# This file is read by the systemd service

# Upload directory for RAUC bundles
UPLOAD_TMP_DIR=/tmp/rauc-bundles

# Server port (default: 8000)
# PORT=8000

# Online updates: a manifest listing the newest bundle per compatible (see
# README, "Online updates"). Without it the page offers uploads only.
# UPDATE_MANIFEST_URL=https://downloads.example.com/my-device/manifest.json
# Accept http:// bundle URLs, e.g. for a test server in the LAN
# ALLOW_HTTP_BUNDLE_URLS=1

# Optional SSH configuration for development
# SSH_HOST=root@localhost
# SSH_PASSWORD=
